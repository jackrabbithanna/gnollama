<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.jackrabbithanna.Gnollama</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>

  <name>Gnollama</name>
  <summary>Chat with Ollama models</summary>
  <description>
    <p>Chat with Ollama models running on your computer or a remote server using a native GNOME interface.</p>
    <p>Keep conversations in separate tabs, attach images to vision models, and read responses with Markdown and highlighted code.</p>
    <p>Manage hosts and models, customize generation and thinking settings, and inspect response statistics including cached prompt tokens.</p>
    <p>Generate and validate structured JSON, import JSON schemas, and export responses. Inspect loaded models and release their memory when finished.</p>
    <p>Save and organize conversations with pinning and editable titles. Stop a response at any time and keep its partial answer in your history.</p>
  </description>

  <developer id="io.github.jackrabbithanna">
    <name>jackrabbithanna</name>
  </developer>

  <!-- Required: Should be a link to the upstream homepage for the component -->
  <url type="homepage">https://github.com/jackrabbithanna/gnollama/</url>
  <!-- Recommended: It is highly recommended for open-source projects to display the source code repository -->
  <url type="vcs-browser">https://github.com/jackrabbithanna/gnollama</url>
  <!-- Should point to the software's bug tracking system, for users to report new bugs -->
  <url type="bugtracker">https://github.com/jackrabbithanna/gnollama/issues</url>
  <!-- Should link a FAQ page for this software, to answer some of the most-asked questions in detail -->
  <!-- URLs of this type should point to a webpage where users can submit or modify translations of the upstream project -->

  <translation type="gettext">gnollama</translation>
  <!-- All graphical applications having a desktop file must have this tag in the MetaInfo.
     If this is present, appstreamcli compose will pull icons, keywords and categories from the desktop file. -->
  <launchable type="desktop-id">io.github.jackrabbithanna.Gnollama.desktop</launchable>
  <!-- Use the OARS website (https://hughsie.github.io/oars/generate.html) to generate these and make sure to use oars-1.1 -->
  <content_rating type="oars-1.1" />

  <!-- Applications should set a brand color in both light and dark variants like so -->
  <branding>
    <color type="primary" scheme_preference="light">#ff00ff</color>
    <color type="primary" scheme_preference="dark">#993d3d</color>
  </branding>

  <screenshots>
    <screenshot type="default">
      <image>https://github.com/jackrabbithanna/gnollama/blob/main/screenshots/gnollama-screenshot.png?raw=true</image>
      <caption>Ollama chat with code highlighting</caption>
    </screenshot>
  </screenshots>

  <releases>
    <release version="0.14.0" date="2026-09-10">
      <description>
        <p>Connect directly to Ollama Cloud from Chat and Response tabs.</p>
        <p>Store each host's API key in the desktop keyring, with session-only use when the keyring is unavailable.</p>
        <p>Browse cloud models with controls adapted to the service, and use local knowledge sources in cloud chats.</p>
      </description>
    </release>
    <release version="0.13.0" date="2026-09-10">
      <description>
        <p>Add a Knowledge Library for text and PDF imports, local embedding indexes, and source-grounded chats.</p>
        <ul>
          <li>Start with knowledge collections and add text, files, or URLs with explicit destinations and guided previews.</li>
          <li>Choose collections before search settings, and use adaptive chat settings with clearer controls and feedback.</li>
          <li>Create and compare embeddings, inspect chunks and vectors, and test semantic searches.</li>
          <li>Select documents or chunks for chats, with independent embedding hosts and saved source passages.</li>
          <li>Warn about stored embeddings when deleting models, with optional vector cleanup that retains source text.</li>
          <li>Search with sqlite-vec, automatically migrate existing vectors with a database backup, and use the Qwen3 retrieval preset.</li>
          <li>Organize documents into collections with shared embedding settings, automatic builds, and live collection selection in chats.</li>
          <li>Choose collections as chat sources and compare cosine similarity, Euclidean distance, or Manhattan distance with appropriate search cutoffs.</li>
          <li>Hide embedding-only models from Chat and Response model selection while keeping them available in Knowledge and Manage Models.</li>
          <li>Import batches of URLs into collections with main-content extraction, CSS selectors, editable previews, and source links in chats.</li>
          <li>Review changed web documents before replacing their text and rebuilding all affected embedding indexes.</li>
        </ul>
      </description>
    </release>
    <release version="0.12.0" date="2026-09-09">
      <description translate="no">
        <p>Add a tool-calling playground for chat tabs with editable function definitions, JSON import and export, and an example.</p>
        <p>Inspect model tool calls, validate arguments, supply mock results, and continue with the current model and settings.</p>
        <p>Preserve pending tool rounds and saved results when reopening chats. Combine tools with JSON and JSON Schema output.</p>
      </description>
    </release>
    <release version="0.11.0" date="2026-09-09">
      <description translate="no">
        <p>Add JSON and JSON Schema output modes with schema import, local validation, and JSON export.</p>
        <p>Inspect running models, unload them from memory, and customize model keep-alive durations.</p>
        <p>Adapt image controls to model capabilities and send text history to models without vision while preserving saved images.</p>
        <p>Use native GNOME tabs and a collapsible sidebar with pinned and recent conversations.</p>
      </description>
    </release>
    <release version="0.10.0" date="2026-09-09">
      <description translate="no">
        <p>Use the GNOME 50 runtime.</p>
        <p>Stop responses and model downloads, preserve partial answers, and reliably save history before quitting.</p>
        <p>Correct thinking controls, refresh host selections, and show cached prompt tokens and generation speed.</p>
      </description>
    </release>
    <release version="0.9.2" date="2026-06-12">
      <url type="details">https://github.com/jackrabbithanna/gnollama/releases/tag/0.9.2</url>
      <description translate="no">
        <p>Add pin chat feature to saved chats</p>
        <p>Use action menu for saved chat actions</p>
      </description>
    </release>
    <release version="0.9.1" date="2026-05-16">
      <url type="details">https://github.com/jackrabbithanna/gnollama/releases/tag/0.9.1</url>
      <description translate="no">
        <p>Update translations</p>
      </description>
    </release>
    <release version="0.9.0" date="2026-05-16">
      <url type="details">https://github.com/jackrabbithanna/gnollama/releases/tag/0.9.0</url>
      <description translate="no">
        <p>Change storage to use SQLite for hosts and chat history</p>
      </description>
    </release>
    <release version="0.8.0" date="2026-05-16">
      <url type="details">https://github.com/jackrabbithanna/gnollama/releases/tag/0.8.0</url>
      <description translate="no">
        <p>Re-architecture of chat tab code, separating components into widgets</p>
        <p>Replace Adw.MessageDialog with Adw.AlertDialog</p>
        <p>Use ThreadPoolExecuter in NetworkWorker</p>
        <p>Improve API error handling</p>
        <p>Improve GTK theme Dark/Light mode</p>
      </description>
    </release>
    <release version="0.7.0" date="2026-04-26">
      <url type="details">https://github.com/jackrabbithanna/gnollama/releases/tag/0.7.0</url>
      <description translate="no">
        <p>Add Manage Hosts dialog to create/edit/delete multiple hosts</p>
        <p>Add Manage Models dialog to add/remove models from a host</p>
        <p>Add model information dialog</p>
      </description>
    </release>
    <release version="0.6.0" date="2026-04-25">
      <url type="details">https://github.com/jackrabbithanna/gnollama/releases/tag/0.6.0</url>
      <description translate="no">
        <p>Add API Details fieldset in response</p>
        <p>Add Clear chat history dialog</p>
        <p>Save model, host, system prompt and other options for each chat in the chat storage</p>
        <p>Set "Show Statistics" checkbox to be checked by default</p>
        <p>Fix chat API extraneous system parameter</p>
      </description>
    </release>
    <release version="0.5.6" date="2025-12-28">
      <url type="details">https://github.com/jackrabbithanna/gnollama/releases/tag/0.5.6</url>
      <description translate="no">
        <p>First production release</p>
      </description>
    </release>
  </releases>

</component>
