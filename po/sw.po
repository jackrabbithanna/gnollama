msgstr "Inaonekana hii ni faili ya mfumo wa jozi, si hati ya maandishi."

#: src/knowledge.py:93
msgid "Chunk size must be 64–32,000 characters; overlap must be smaller than the chunk."
msgstr ""
"Ukubwa wa kipande lazima uwe herufi 64–32,000; mwingiliano lazima uwe mdogo kuliko "
"kipande."

#: src/knowledge.py:119
msgid ""
"The embedding model is unavailable or its digest is missing. Choose a compatible host"
