<interface domain="gnollama">
  <requires lib="gtk" version="4.0" />
  <requires lib="Adw" version="1.0" />
  <template class="HostEditDialog" parent="AdwDialog">
    <property name="content-width">440</property>
    <property name="child">
      <object class="AdwToolbarView">
        <child type="top">
          <object class="AdwHeaderBar">
            <property name="show-start-title-buttons">False</property>
            <property name="show-end-title-buttons">False</property>
            <child type="start">
              <object class="GtkButton" id="cancel_button">
                <property name="label" translatable="yes">Cancel</property>
              </object>
            </child>
            <child type="end">
              <object class="GtkButton" id="save_button">
                <property name="label" translatable="yes">Save</property>
                <style><class name="suggested-action"/></style>
              </object>
            </child>
          </object>
        </child>
        <property name="content">
          <object class="GtkScrolledWindow">
            <property name="hscrollbar-policy">never</property>
            <property name="propagate-natural-height">True</property>
            <property name="child">
      <object class="GtkBox" id="fields_box">
        <property name="orientation">vertical</property>
        <property name="spacing">12</property>
        <property name="margin-start">12</property>
        <property name="margin-end">12</property>
        <property name="margin-top">12</property>
        <property name="margin-bottom">12</property>
        <child>
          <object class="GtkLabel">
            <property name="label" translatable="yes">Host type</property>
            <property name="xalign">0</property>
            <property name="mnemonic-widget">provider_dropdown</property>
          </object>
        </child>
        <child><object class="GtkDropDown" id="provider_dropdown"/></child>
        <child>
          <object class="GtkLabel">
            <property name="label" translatable="yes">Name</property>
            <property name="xalign">0</property>
            <property name="mnemonic-widget">name_entry</property>
          </object>
        </child>
        <child>
          <object class="GtkEntry" id="name_entry">
            <property name="placeholder-text" translatable="yes">For example: Local Ollama</property>
          </object>
        </child>
        <child>
          <object class="GtkLabel">
            <property name="label" translatable="yes">Server address</property>
            <property name="xalign">0</property>
            <property name="mnemonic-widget">hostname_entry</property>
          </object>
        </child>
        <child>
          <object class="GtkEntry" id="hostname_entry">
            <property name="placeholder-text">http://localhost:11434</property>
          </object>
        </child>
        <child>
          <object class="GtkCheckButton" id="default_check">
            <property name="label" translatable="yes">Set as default host</property>
          </object>
        </child>
      </object>
            </property>
          </object>
        </property>
      </object>
    </property>
  </template>
</interface>
