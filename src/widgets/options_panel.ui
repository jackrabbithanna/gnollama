<interface>
  <requires lib="gtk" version="4.0" />
  <requires lib="Adw" version="1.0" />
  <template class="OptionsPanel" parent="GtkBox">
    <property name="orientation">vertical</property>
    <property name="spacing">6</property>
    <property name="margin-start">12</property>
    <property name="margin-end">12</property>
    <property name="margin-bottom">12</property>
    <child>
      <object class="GtkBox" id="tools_box">
        <property name="orientation">vertical</property>
        <property name="spacing">6</property>
        <property name="visible">False</property>
        <child>
          <object class="GtkBox">
            <property name="spacing">6</property>
            <child>
              <object class="GtkCheckButton" id="tools_check">
                <property name="label" translatable="yes">Tool Calling</property>
                <property name="hexpand">True</property>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="tools_button">
                <property name="label" translatable="yes">Edit Tools…</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkLabel" id="tools_notice">
            <property name="xalign">0</property>
            <property name="wrap">True</property>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="GtkBox">
        <property name="spacing">6</property>
        <child>
          <object class="GtkLabel">
            <property name="label" translatable="yes">Output:</property>
            <property name="mnemonic-widget">output_dropdown</property>
            <property name="wrap">True</property>
          </object>
        </child>
        <child>
          <object class="GtkDropDown" id="output_dropdown">
            <property name="hexpand">True</property>
          </object>
        </child>
        <child>
          <object class="GtkButton" id="schema_button">
            <property name="label" translatable="yes">Edit Schema…</property>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="GtkButton" id="settings_button">
        <property name="label" translatable="yes">Chat Settings…</property>
        <property name="halign">start</property>
        <property name="tooltip-text" translatable="yes">Generation, Model Retention, and Diagnostics</property>
      </object>
    </child>
    <style>
      <class name="chat-options" />
    </style>
  </template>
</interface>
