<interface>
  <requires lib="gtk" version="4.0" />
  <requires lib="Adw" version="1.0" />
  <template class="OptionsPanel" parent="GtkBox">
    <property name="orientation">vertical</property>
    <property name="spacing">6</property>
    <property name="margin-start">12</property>
    <property name="margin-end">12</property>
    <property name="margin-bottom">12</property>
    <child>
      <object class="GtkBox" id="tools_box">
        <property name="orientation">vertical</property>
        <property name="spacing">6</property>
        <property name="visible">False</property>
        <child>
          <object class="GtkBox">
            <property name="spacing">6</property>
            <child>
              <object class="GtkCheckButton" id="tools_check">
                <property name="label" translatable="yes">Tool Calling</property>
                <property name="hexpand">True</property>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="tools_button">
                <property name="label" translatable="yes">Edit Tools…</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkLabel" id="tools_notice">
            <property name="xalign">0</property>
            <property name="wrap">True</property>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="GtkBox">
        <property name="spacing">6</property>
        <child>
          <object class="GtkLabel">
            <property name="label" translatable="yes">Output:</property>
            <property name="wrap">True</property>
          </object>
        </child>
        <child>
          <object class="GtkDropDown" id="output_dropdown">
            <property name="hexpand">True</property>
          </object>
        </child>
        <child>
          <object class="GtkButton" id="schema_button">
            <property name="label" translatable="yes">Edit Schema…</property>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="GtkExpander" id="advanced_expander">
        <property name="label" translatable="yes">Advanced Settings</property>
        <property name="margin-top">6</property>
        <child>
          <object class="GtkScrolledWindow">
            <property name="hscrollbar-policy">never</property>
            <property name="propagate-natural-height">True</property>
            <property name="max-content-height">300</property>
            <child>
              <object class="GtkBox">
                <property name="orientation">vertical</property>
                <property name="spacing">6</property>
                <child>
                  <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <property name="spacing">6</property>
                    <child>
                      <object class="GtkLabel">
                        <property name="label" translatable="yes">Keep model loaded</property>
                        <property name="xalign">0</property>
                        <property name="wrap">True</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkDropDown" id="keep_alive_dropdown" />
                    </child>
                    <child>
                      <object class="GtkEntry" id="keep_alive_entry">
                        <property name="placeholder-text" translatable="yes">Positive number of seconds</property>
                        <property name="input-purpose">digits</property>
                        <property name="width-chars">8</property>
                        <property name="max-width-chars">20</property>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkBox">
                    <property name="orientation">horizontal</property>
                    <property name="spacing">6</property>
                    <child>
                      <object class="GtkLabel">
                        <property name="label" translatable="yes">Ollama Host:</property>
                        <property name="wrap">True</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkDropDown" id="host_dropdown">
                        <property name="valign">center</property>
                        <property name="hexpand">True</property>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkEntry" id="system_prompt_entry">
                    <property name="placeholder-text" translatable="yes">System Prompt (optional)</property>
                    <property name="width-chars">8</property>
                    <property name="max-width-chars">20</property>
                  </object>
                </child>
                <child>
                  <object class="GtkCheckButton" id="stats_check">
                    <property name="label" translatable="yes">Show statistics</property>
                    <property name="active">True</property>
                  </object>
                </child>
                <child>
                  <object class="GtkCheckButton" id="logprobs_check">
                    <property name="label" translatable="yes">Return logprobs</property>
                  </object>
                </child>
                <child>
                  <object class="GtkBox">
                    <property name="orientation">horizontal</property>
                    <property name="spacing">6</property>
                    <child>
                      <object class="GtkLabel">
                        <property name="label" translatable="yes">Top Logprobs:</property>
                        <property name="wrap">True</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkEntry" id="top_logprobs_entry">
                        <property name="placeholder-text" translatable="yes">Integer (e.g., 5)</property>
                        <property name="width-chars">8</property>
                        <property name="max-width-chars">20</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel">
                        <property name="label" translatable="yes">Number of top logprobs to return</property>
                        <style>
                          <class name="dim-label" />
                        </style>
                        <property name="wrap">True</property>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkGrid">
                    <property name="column-spacing">12</property>
                    <property name="row-spacing">6</property>
                    <child>
                      <object class="GtkLabel">
                        <property name="label" translatable="yes">Seed:</property>
                        <property name="halign">end</property>
                        <layout>
                          <property name="column">0</property>
                          <property name="row">0</property>
                        </layout>
                        <property name="wrap">True</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkEntry" id="seed_entry">
                        <property name="placeholder-text" translatable="yes">Integer</property>
                        <property name="tooltip-text" translatable="yes">Random number seed</property>
                        <property name="hexpand">True</property>
                        <layout>
                          <property name="column">1</property>
                          <property name="row">0</property>
                        </layout>
                        <property name="width-chars">8</property>
                        <property name="max-width-chars">20</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel">
                        <property name="label" translatable="yes">Temperature:</property>
                        <property name="halign">end</property>
                        <layout>
                          <property name="column">0</property>
                          <property name="row">1</property>
                        </layout>
                        <property name="wrap">True</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkEntry" id="temperature_entry">
                        <property name="placeholder-text" translatable="yes">Float</property>
                        <property name="tooltip-text" translatable="yes">Creativity (0.0 - 1.0)</property>
                        <property name="hexpand">True</property>
                        <layout>
                          <property name="column">1</property>
                          <property name="row">1</property>
                        </layout>
                        <property name="width-chars">8</property>
                        <property name="max-width-chars">20</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel">
                        <property name="label" translatable="yes">Top K:</property>
                        <property name="halign">end</property>
                        <layout>
                          <property name="column">0</property>
                          <property name="row">2</property>
                        </layout>
                        <property name="wrap">True</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkEntry" id="top_k_entry">
                        <property name="placeholder-text" translatable="yes">Integer</property>
                        <property name="tooltip-text" translatable="yes">Limit to top K tokens</property>
                        <property name="hexpand">True</property>
                        <layout>
                          <property name="column">1</property>
                          <property name="row">2</property>
                        </layout>
                        <property name="width-chars">8</property>
                        <property name="max-width-chars">20</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel">
                        <property name="label" translatable="yes">Top P:</property>
                        <property name="halign">end</property>
                        <layout>
                          <property name="column">0</property>
                          <property name="row">3</property>
                        </layout>
                        <property name="wrap">True</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkEntry" id="top_p_entry">
                        <property name="placeholder-text" translatable="yes">Float</property>
                        <property name="tooltip-text" translatable="yes">Limit to cumulative probability P</property>
                        <property name="hexpand">True</property>
                        <layout>
                          <property name="column">1</property>
                          <property name="row">3</property>
                        </layout>
                        <property name="width-chars">8</property>
                        <property name="max-width-chars">20</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel">
                        <property name="label" translatable="yes">Min P:</property>
                        <property name="halign">end</property>
                        <layout>
                          <property name="column">0</property>
                          <property name="row">4</property>
                        </layout>
                        <property name="wrap">True</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkEntry" id="min_p_entry">
                        <property name="placeholder-text" translatable="yes">Float</property>
                        <property name="tooltip-text" translatable="yes">Minimum probability</property>
                        <property name="hexpand">True</property>
                        <layout>
                          <property name="column">1</property>
                          <property name="row">4</property>
                        </layout>
                        <property name="width-chars">8</property>
                        <property name="max-width-chars">20</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel">
                        <property name="label" translatable="yes">Context Size:</property>
                        <property name="halign">end</property>
                        <layout>
                          <property name="column">0</property>
                          <property name="row">5</property>
                        </layout>
                        <property name="wrap">True</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkEntry" id="num_ctx_entry">
                        <property name="placeholder-text" translatable="yes">Integer</property>
                        <property name="tooltip-text" translatable="yes">Context window size (num_ctx)</property>
                        <property name="hexpand">True</property>
                        <layout>
                          <property name="column">1</property>
                          <property name="row">5</property>
                        </layout>
                        <property name="width-chars">8</property>
                        <property name="max-width-chars">20</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel">
                        <property name="label" translatable="yes">Max Tokens:</property>
                        <property name="halign">end</property>
                        <layout>
                          <property name="column">0</property>
                          <property name="row">6</property>
                        </layout>
                        <property name="wrap">True</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkEntry" id="num_predict_entry">
                        <property name="placeholder-text" translatable="yes">Integer</property>
                        <property name="tooltip-text" translatable="yes">Max tokens to generate (num_predict)</property>
                        <property name="hexpand">True</property>
                        <layout>
                          <property name="column">1</property>
                          <property name="row">6</property>
                        </layout>
                        <property name="width-chars">8</property>
                        <property name="max-width-chars">20</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel">
                        <property name="label" translatable="yes">Stop Seq:</property>
                        <property name="halign">end</property>
                        <layout>
                          <property name="column">0</property>
                          <property name="row">7</property>
                        </layout>
                        <property name="wrap">True</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkEntry" id="stop_entry">
                        <property name="placeholder-text" translatable="yes">String</property>
                        <property name="tooltip-text" translatable="yes">Stop sequence (comma separated)</property>
                        <property name="hexpand">True</property>
                        <layout>
                          <property name="column">1</property>
                          <property name="row">7</property>
                        </layout>
                        <property name="width-chars">8</property>
                        <property name="max-width-chars">20</property>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </template>
</interface>
