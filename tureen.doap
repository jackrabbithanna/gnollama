<?xml version="1.0" encoding="UTF-8"?>
<Project xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:foaf="http://xmlns.com/foaf/0.1/"
         xmlns:gnome="http://api.gnome.org/doap-extensions#"
         xmlns="http://usefulinc.com/ns/doap#">

  <name>Tureen</name>
  <shortdesc xml:lang="en">Native GNOME client for local and cloud AI: chat, compare models, generate images, and create local RAG collections</shortdesc>
  <description xml:lang="en">
A GNOME user interface for local and cloud AI models. Connects to Ollama, LM Studio, and other OpenAI-compatible servers, and to Ollama Cloud, OpenAI, OpenRouter, and the Vercel AI Gateway.
Supports multi-turn chats and single-turn responses, side-by-side comparisons of several models, and conversations between two models.
Supports decision models, which answer yes/no, choice, score, and box questions with probabilities, and generating images from a prompt.
Builds knowledge collections from documents, web pages, and images, and uses them as sources for chat answers.
Supports images, system prompts, thinking controls, structured JSON output, tool calling, and generation settings such as temperature.
Renders Markdown, tables, math, and highlighted code in responses.
Saves chats, decisions, and images, with drafts, search, and pinning.
  </description>

  <homepage rdf:resource="https://github.com/jackrabbithanna/tureen/" />
  <bug-database rdf:resource="https://github.com/jackrabbithanna/tureen/issues/" />

  <programming-language>Python</programming-language>

  <maintainer>
    <foaf:Person>
      <foaf:name>Mark Hanna</foaf:name>
      <foaf:mbox rdf:resource="mailto:mark@jackrabbithanna.com" />
    </foaf:Person>
  </maintainer>

</Project>
